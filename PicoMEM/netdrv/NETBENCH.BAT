@ECHO OFF
REM NETBENCH base-url label [DISK]
REM Times HTGET against a server offering base-url/1mb, /5mb and /10mb:
REM 1MB twice, 5MB and 10MB once to NUL, then 1MB to disk. With DISK
REM as the third argument it also writes 5MB and 10MB to disk, and every
REM disk run logs the CRC-32 of the saved file (C:\TOOLS\HD.EXE) so it
REM can be checked against the server copy.
REM Needs C:\WORK\ELAPSED.COM. CALL it from a job, never run it bare, or
REM the job batch never gets control back. Results APPEND to C:\WORK\NB.LOG:
REM a CALLed batch is not redirected.
REM A run counts only for a 2xx answer. HTGET exits 20-29 for 200 OK,
REM 45 or more for a 404 and 1 when it cannot connect -- measured. Its
REM "200 OK" line goes to stderr, where a FIND cannot see it. Testing
REM for 20 or more alone passed a 404: a transfer of nothing, and the
REM fastest time on the sheet. The test comes straight after HTGET,
REM because ELAPSED resets the errorlevel.
REM No SET anywhere: a box booted without SHELL /E has 256 bytes of
REM environment and a SET here is what runs it out.
REM No pipe either: COMMAND.COM builds one from temp files in %TEMP%,
REM and a bad TEMP drops the output without a word -- which is how the
REM first run with DISK came back with no CRC lines.
IF "%1"=="" GOTO USAGE
C:\WORK\ELAPSED.COM /S
C:\NETWORK\MTCP\HTGET.EXE -o NUL %1/1mb > NUL
IF ERRORLEVEL 30 GOTO BAD1
IF NOT ERRORLEVEL 20 GOTO BAD1
C:\WORK\ELAPSED.COM %2 1MB-NUL >> C:\WORK\NB.LOG
GOTO NXT1
:BAD1
ECHO %2 1MB-NUL FAILED >> C:\WORK\NB.LOG
:NXT1
C:\WORK\ELAPSED.COM /S
C:\NETWORK\MTCP\HTGET.EXE -o NUL %1/1mb > NUL
IF ERRORLEVEL 30 GOTO BAD2
IF NOT ERRORLEVEL 20 GOTO BAD2
C:\WORK\ELAPSED.COM %2 1MB-NUL >> C:\WORK\NB.LOG
GOTO NXT2
:BAD2
ECHO %2 1MB-NUL FAILED >> C:\WORK\NB.LOG
:NXT2
C:\WORK\ELAPSED.COM /S
C:\NETWORK\MTCP\HTGET.EXE -o NUL %1/5mb > NUL
IF ERRORLEVEL 30 GOTO BAD3
IF NOT ERRORLEVEL 20 GOTO BAD3
C:\WORK\ELAPSED.COM %2 5MB-NUL >> C:\WORK\NB.LOG
GOTO NXT3
:BAD3
ECHO %2 5MB-NUL FAILED >> C:\WORK\NB.LOG
:NXT3
C:\WORK\ELAPSED.COM /S
C:\NETWORK\MTCP\HTGET.EXE -o NUL %1/10mb > NUL
IF ERRORLEVEL 30 GOTO BAD4
IF NOT ERRORLEVEL 20 GOTO BAD4
C:\WORK\ELAPSED.COM %2 10MB-NUL >> C:\WORK\NB.LOG
GOTO NXT4
:BAD4
ECHO %2 10MB-NUL FAILED >> C:\WORK\NB.LOG
:NXT4
IF EXIST C:\WORK\NB.BIN DEL C:\WORK\NB.BIN
C:\WORK\ELAPSED.COM /S
C:\NETWORK\MTCP\HTGET.EXE -o C:\WORK\NB.BIN %1/1mb > NUL
IF ERRORLEVEL 30 GOTO BAD5
IF NOT ERRORLEVEL 20 GOTO BAD5
C:\WORK\ELAPSED.COM %2 1MB-DISK >> C:\WORK\NB.LOG
GOTO NXT5
:BAD5
ECHO %2 1MB-DISK FAILED >> C:\WORK\NB.LOG
:NXT5
IF EXIST C:\WORK\NB.BIN C:\TOOLS\HD.EXE C:\WORK\NB.BIN 0 0 > C:\WORK\NB.CRC
IF EXIST C:\WORK\NB.CRC FIND "crc32" < C:\WORK\NB.CRC >> C:\WORK\NB.LOG
IF EXIST C:\WORK\NB.CRC DEL C:\WORK\NB.CRC
IF EXIST C:\WORK\NB.BIN DEL C:\WORK\NB.BIN
IF NOT "%3"=="DISK" GOTO END
IF EXIST C:\WORK\NB.BIN DEL C:\WORK\NB.BIN
C:\WORK\ELAPSED.COM /S
C:\NETWORK\MTCP\HTGET.EXE -o C:\WORK\NB.BIN %1/5mb > NUL
IF ERRORLEVEL 30 GOTO BAD6
IF NOT ERRORLEVEL 20 GOTO BAD6
C:\WORK\ELAPSED.COM %2 5MB-DISK >> C:\WORK\NB.LOG
GOTO NXT6
:BAD6
ECHO %2 5MB-DISK FAILED >> C:\WORK\NB.LOG
:NXT6
IF EXIST C:\WORK\NB.BIN C:\TOOLS\HD.EXE C:\WORK\NB.BIN 0 0 > C:\WORK\NB.CRC
IF EXIST C:\WORK\NB.CRC FIND "crc32" < C:\WORK\NB.CRC >> C:\WORK\NB.LOG
IF EXIST C:\WORK\NB.CRC DEL C:\WORK\NB.CRC
IF EXIST C:\WORK\NB.BIN DEL C:\WORK\NB.BIN
IF EXIST C:\WORK\NB.BIN DEL C:\WORK\NB.BIN
C:\WORK\ELAPSED.COM /S
C:\NETWORK\MTCP\HTGET.EXE -o C:\WORK\NB.BIN %1/10mb > NUL
IF ERRORLEVEL 30 GOTO BAD7
IF NOT ERRORLEVEL 20 GOTO BAD7
C:\WORK\ELAPSED.COM %2 10MB-DISK >> C:\WORK\NB.LOG
GOTO NXT7
:BAD7
ECHO %2 10MB-DISK FAILED >> C:\WORK\NB.LOG
:NXT7
IF EXIST C:\WORK\NB.BIN C:\TOOLS\HD.EXE C:\WORK\NB.BIN 0 0 > C:\WORK\NB.CRC
IF EXIST C:\WORK\NB.CRC FIND "crc32" < C:\WORK\NB.CRC >> C:\WORK\NB.LOG
IF EXIST C:\WORK\NB.CRC DEL C:\WORK\NB.CRC
IF EXIST C:\WORK\NB.BIN DEL C:\WORK\NB.BIN
GOTO END
:USAGE
ECHO usage: NETBENCH base-url label [DISK]
:END
